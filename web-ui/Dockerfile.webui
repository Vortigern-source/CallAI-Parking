# Frontend Build Stage
FROM node:18-alpine AS frontend-build
WORKDIR /app/frontend

# Install frontend dependencies
COPY web-ui/package*.json ./
RUN npm ci

# Copy frontend source
COPY web-ui/src ./src
COPY web-ui/public ./public
COPY web-ui/.env* ./

# Build frontend
RUN npm run build

# Backend Build Stage
FROM python:3.9-slim
WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY web-ui/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install alembic uvicorn

# Copy backend source
COPY web-ui/backend/ ./

# Copy frontend build
COPY --from=frontend-build /app/frontend/build /app/backend/frontend

# Create data directory
RUN mkdir -p /app/backend/data && chmod 777 /app/backend/data

# Expose ports
EXPOSE 8000 3000

# Environment settings
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DATABASE_URL=sqlite:////app/backend/data/parking.db
ENV INITIAL_ADMIN_USERNAME=admin
ENV INITIAL_ADMIN_EMAIL=admin@example.com
ENV INITIAL_ADMIN_PASSWORD=TestAdmin123!

# Entrypoint script
COPY web-ui/backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set working directory
WORKDIR /app/backend

# Entrypoint
ENTRYPOINT ["/entrypoint.sh"]
