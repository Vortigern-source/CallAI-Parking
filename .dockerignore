# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
*.egg-info/
dist/
build/
*.egg

# Node.js - explicitly list what to ignore
web-ui/node_modules/
web-ui/.pnp
web-ui/.pnp.js
web-ui/coverage/
web-ui/build/
web-ui/.env.local
web-ui/.env.development.local
web-ui/.env.test.local
web-ui/.env.production.local
web-ui/npm-debug.log*
web-ui/yarn-debug.log*
web-ui/yarn-error.log*

# Make sure to keep these files
!web-ui/package.json
!web-ui/package-lock.json
!web-ui/src/
!web-ui/public/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# Docker
.docker/

# Testing
.coverage
.pytest_cache/
htmlcov/

# Documentation
docs/

# Local development
*.local
.DS_Store
Thumbs.db
